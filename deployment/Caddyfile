{
	# On-demand TLS для доменов учебных страниц (модуль "Домены" — см.
	# backend/src/modules/domains/). При каждом новом TLS-рукопожатии для
	# неизвестного домена Caddy спрашивает backend "можно ли этому домену
	# сертификат?" — 2xx только если домен верифицирован (VERIFIED) в БД.
	# Синтаксис подтверждён официальной документацией Caddy 2.9
	# (caddyserver.com/docs/caddyfile/options#on-demand-tls) — `ask` это
	# задокументированный путь, отдельного allowlist-модуля без ask не существует.
	on_demand_tls {
		ask http://backend:3000/internal/tls-ask
	}
}

{$DOMAIN} {
	# Публичные/API-пути уходят на backend (он сам слушает их без префикса /api,
	# кроме REST API под /api — см. backend/src/main.ts setGlobalPrefix).
	handle /api/* {
		reverse_proxy backend:3000
	}
	handle /health {
		reverse_proxy backend:3000
	}
	handle /lp/* {
		reverse_proxy backend:3000
	}
	handle /t/* {
		reverse_proxy backend:3000
	}

	# Всё остальное — статика SPA фронтенда.
	handle {
		reverse_proxy frontend:80
	}

	encode gzip
}

# Кастомные домены учебных страниц (модуль "Домены"): обслуживают ТОЛЬКО
# граббер/учебные страницы и трекинг — не интерфейс администратора. Список
# разрешённых hostname'ов пуст по умолчанию (tls automation policy ниже),
# заполняется через Admin API после верификации владения доменом.
:443 {
	tls {
		on_demand
	}
	handle /lp/* {
		reverse_proxy backend:3000
	}
	handle /t/* {
		reverse_proxy backend:3000
	}
	handle {
		respond 404
	}

	encode gzip
}

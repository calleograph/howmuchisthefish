# Security Awareness Platform — конфигурация развёртывания.
# Скопируйте в .env рядом с compose.yml и замените все значения CHANGE_ME_*.
# scripts/preflight.sh отказывает в установке, если хотя бы одно осталось.

# --- Экземпляр ---
COMPOSE_PROJECT_NAME=sap

# --- Публикация: встроенный HTTPS (по умолчанию) ---
# Домен, на который указывает DNS A-запись этого сервера. Используется Caddy
# для автоматического получения сертификата Let's Encrypt.
DOMAIN=CHANGE_ME_YOUR_DOMAIN.example

# Публичный адрес приложения (обычно https://DOMAIN) — используется в
# ссылках писем, трекинг-пикселе, CORS.
PUBLIC_BASE_URL=https://CHANGE_ME_YOUR_DOMAIN.example

# --- Публикация: за внешним reverse proxy (альтернатива, см. README) ---
# Используются только с compose.external-proxy.yml — порты на 127.0.0.1.
BACKEND_PORT=3000
FRONTEND_PORT=8080

# --- Секреты (генерируются установщиком: openssl rand -hex 32) ---
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
JWT_SECRET=CHANGE_ME_JWT_SECRET
# Мастер-ключ шифрования секретов в БД (SMTP-пароли и т.п.). Храните отдельно
# от резервных копий — без него зашифрованные значения не восстановить.
APP_MASTER_KEY=CHANGE_ME_APP_MASTER_KEY

# --- Логирование ---
LOG_LEVEL=info

# --- OIDC (опционально) ---
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# --- SAML (опционально, legacy-путь для организаций без OIDC) ---
SAML_ENABLED=false
SAML_IDP_METADATA_URL=
SAML_ENTITY_ID=

# --- Образы (для production-установки из GHCR; оставьте пустыми для сборки
# из исходников локально) ---
BACKEND_IMAGE=
FRONTEND_IMAGE=

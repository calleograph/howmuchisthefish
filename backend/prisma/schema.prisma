// Security Awareness Platform — схема данных.
//
// Соглашение о комментариях-политиках бэкапа (см. docs/BACKUP_RESTORE.md,
// src/modules/admin/config-registry.ts): каждое поле, которое войдёт в экспорт
// конфигурации, помечено одной из политик прямо в комментарии:
//   @policy:data   — переносится как есть
//   @policy:secret — переносится в зашифрованном виде, при экспорте не показывается
//   @policy:hash   — переносится как хэш (работает, но не восстанавливается в открытом виде)
//   @policy:reset  — не переносится, после восстановления требует повторной настройки
// Тест backend/test/config-registry.spec.ts проверяет, что каждое поле модели
// Settings/SmtpConfig/User(password) явно описано в реестре — иначе падает.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  FINISHED
  FAILED
}

enum CampaignEventType {
  EMAIL_SENT
  EMAIL_OPENED
  LINK_CLICKED
  FORM_SUBMITTED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique // @policy:data
  passwordHash  String?   // @policy:hash — bcrypt-хэш локального пароля, null если вход только через OIDC/SAML
  firstName     String    // @policy:data
  lastName      String    // @policy:data
  role          Role      @default(VIEWER) // @policy:data
  mfaEnabled    Boolean   @default(false) // @policy:data
  mfaSecret     String?   // @policy:secret
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  auditLogs     AuditLog[]

  @@map("users")
}

// Сотрудники-цели кампаний — отдельная сущность от административных User.
model Employee {
  id          String   @id @default(uuid())
  email       String   @unique // @policy:data
  firstName   String   // @policy:data
  lastName    String   // @policy:data
  department  String?  // @policy:data
  position    String?  // @policy:data
  isActive    Boolean  @default(true)
  importedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  groups        EmployeeGroup[]
  targets       CampaignTarget[]
  history       EmployeeHistory[]

  @@map("employees")
}

model EmployeeHistory {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  changedBy  String?  // userId администратора, null для импорта
  changeType String   // created | updated | imported | deactivated
  diff       Json     // @policy:data — снимок изменённых полей (без значений форм кампаний)
  createdAt  DateTime @default(now())

  @@map("employee_history")
}

model Group {
  id          String   @id @default(uuid())
  name        String   @unique // @policy:data
  description String?  // @policy:data
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     EmployeeGroup[]
  targets     CampaignTarget[]

  @@map("groups")
}

model EmployeeGroup {
  employeeId String
  groupId    String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([employeeId, groupId])
  @@map("employee_groups")
}

model MailTemplate {
  id          String   @id @default(uuid())
  name        String   // @policy:data
  subject     String   // @policy:data
  mjmlSource  String   // @policy:data — исходник MJML
  htmlCache   String   // @policy:data — скомпилированный HTML (кэш, пересчитывается из mjmlSource)
  variables   Json     @default("[]") // @policy:data — список переменных персонализации
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns   Campaign[]

  @@map("mail_templates")
}

model LandingPage {
  id          String   @id @default(uuid())
  name        String   // @policy:data
  slug        String   @unique // @policy:data — публичный путь /lp/{slug}
  htmlSource  String   // @policy:data — HTML учебной страницы (из конструктора или ручной правки)
  formEnabled Boolean  @default(false) // @policy:data
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns   Campaign[]

  @@map("landing_pages")
}

model SmtpConfig {
  id            String   @id @default(uuid())
  name          String   // @policy:data
  host          String   // @policy:data
  port          Int      // @policy:data
  secure        Boolean  @default(true) // @policy:data — TLS/STARTTLS
  username      String?  // @policy:data
  passwordEnc   String?  // @policy:secret — зашифровано APP_MASTER_KEY, не экспортируется в открытом виде
  fromAddress   String   // @policy:data
  isDefault     Boolean  @default(false)
  lastTestAt    DateTime?
  lastTestOk    Boolean?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  campaigns     Campaign[]

  @@map("smtp_configs")
}

model Campaign {
  id            String         @id @default(uuid())
  name          String         // @policy:data
  status        CampaignStatus @default(DRAFT) // @policy:data
  templateId    String
  template      MailTemplate   @relation(fields: [templateId], references: [id])
  pageId        String
  page          LandingPage    @relation(fields: [pageId], references: [id])
  smtpConfigId  String
  smtpConfig    SmtpConfig     @relation(fields: [smtpConfigId], references: [id])
  scheduledAt   DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?
  sendRateLimit Int            @default(10) // писем в минуту — @policy:data
  allowedDomainsOverride Json? // @policy:data — если задано, ограничивает адресатов этими доменами
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  targets       CampaignTarget[]
  events        CampaignEvent[]

  @@map("campaigns")
}

model CampaignTarget {
  id          String    @id @default(uuid())
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  employeeId  String?
  employee    Employee? @relation(fields: [employeeId], references: [id])
  groupId     String?
  group       Group?    @relation(fields: [groupId], references: [id])
  trackingToken String  @unique @default(uuid()) // используется в pixel/redirect ссылках, не ПДн само по себе
  createdAt   DateTime  @default(now())

  events      CampaignEvent[]

  // Один сотрудник не может быть целью одной кампании дважды — делает addTargets
  // идемпотентным при повторном вызове (например при обновлении состава получателей).
  @@unique([campaignId, employeeId])
  @@map("campaign_targets")
}

// Критическое требование безопасности (задание §5, §2.5): здесь НИКОГДА не появится поле
// для значений, введённых в форму учебной страницы (логин/пароль и т.п.). Схема рассчитана
// только на факт события. См. docs/SECURITY.md "Почему нет поля form_data".
model CampaignEvent {
  id          String            @id @default(uuid())
  campaignId  String
  campaign    Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  targetId    String
  target      CampaignTarget    @relation(fields: [targetId], references: [id], onDelete: Cascade)
  type        CampaignEventType // @policy:data
  isSuspiciousAutomated Boolean @default(false) // @policy:data — похоже на сканер/почтовый клиент, не на человека
  userAgent   String?           // @policy:data — для классификации сканеров, не для идентификации человека
  ipAddress   String?           // @policy:data — усечённый/опционально отключаемый, см. SECURITY.md retention
  createdAt   DateTime          @default(now())

  @@index([campaignId, type])
  @@map("campaign_events")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String   // @policy:data
  entityType String   // @policy:data
  entityId   String?  // @policy:data
  metadata   Json?    // @policy:data
  ipAddress  String?  // @policy:data
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

// Общие настройки приложения — key/value с явной политикой на уровне записи
// (используется config-registry.ts, т.к. набор ключей расширяемый).
model Setting {
  key         String   @id // @policy:data
  value       Json     // политика зависит от key — см. config-registry.ts SETTINGS_POLICY
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

model Backup {
  id          String   @id @default(uuid())
  label       String   // @policy:data
  kind        String   // manual | scheduled | pre-update | pre-restore
  filePath    String   // @policy:data — путь в storage, не содержимое
  sizeBytes   BigInt
  checksum    String   // @policy:data — sha256 для проверки целостности
  encrypted   Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("backups")
}

# HowMuchIsTheFish — переменные окружения backend.
# Скопируйте в .env и замените все значения CHANGE_ME_* перед запуском.
# preflight-проверка установщика (scripts/preflight.sh) отказывает в запуске,
# если хотя бы одно значение CHANGE_ME_* осталось нетронутым.

# --- Общие ---
NODE_ENV=production
PORT=3000
# Публичный адрес, на котором доступна система (используется в ссылках писем/пикселях). На CORS не влияет.
PUBLIC_BASE_URL=https://CHANGE_ME_YOUR_DOMAIN.example
# CORS: пусто по умолчанию = разрешён доступ с любого адреса. Заполните
# через запятую, когда адреса доступа станут известны — ужесточение CORS,
# шаг ПОСЛЕ первичной настройки, не обязателен сразу. См. CONFIGURATION.md.
CORS_ALLOWED_ORIGINS=

# --- База данных ---
DATABASE_URL=postgresql://sap:CHANGE_ME_DB_PASSWORD@postgres:5432/sap

# --- Безопасность ---
# Используется для подписи JWT. Генерируется установщиком (openssl rand -hex 32), не придумывать вручную.
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_EXPIRES_IN=24h
# Мастер-ключ для шифрования секретов в БД (SMTP-пароли и т.п.), AES-256-GCM.
# Генерируется установщиком. Хранить ОТДЕЛЬНО от резервных копий — без него секреты не восстановить.
APP_MASTER_KEY=CHANGE_ME_APP_MASTER_KEY

# --- OIDC (опционально) ---
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# --- SAML (опционально, legacy-путь) ---
SAML_ENABLED=false
SAML_IDP_METADATA_URL=
SAML_ENTITY_ID=

# --- Хранение файлов ---
STORAGE_ROOT=/data/storage

# --- Логирование ---
LOG_LEVEL=info

# --- Ограничение частоты запросов ---
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=100

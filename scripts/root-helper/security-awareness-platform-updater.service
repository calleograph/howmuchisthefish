[Unit]
Description=Security Awareness Platform — root-helper для обновлений (один проход)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
# Путь подставляется установщиком при копировании unit-файла в /etc/systemd/system/.
ExecStart=/opt/security-awareness-platform/scripts/root-helper/updater.sh
Environment=SAP_EXCHANGE_DIR=/var/lib/security-awareness-platform/updater

# Белый список действий внутри updater.sh — это вторая линия защиты; первая —
# то, что служба вообще ничего не делает без лежащего в каталоге обмена
# валидного запроса от известного uid (см. validate_request_file).
